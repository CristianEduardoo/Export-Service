# Plantilla de configuración. Copiar a .env y ajustar: cp .env.example .env

# --- General ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API de origen ----------------------------------------------------------
SOURCE_API_URL=http://source-api:8090
SOURCE_API_TIMEOUT_SECONDS=10
# Pequeño a propósito
SOURCE_API_PAGE_SIZE=5
# Tope de seguridad: evita un bucle infinito si la API devolviera siempre has_next=true
SOURCE_API_MAX_PAGES=1000
# Reintentos solo ante fallos transitorios (timeout, conexión, 429, 502, 503, 504)
SOURCE_API_MAX_RETRIES=3
SOURCE_API_BACKOFF_BASE_SECONDS=1
SOURCE_API_BACKOFF_MAX_SECONDS=30

# --- Exportación ------------------------------------------------------------
# Fecha desde la que se exporta en la primera ejecución; después se usa la marca
# de agua de la última ejecución completada. Siempre en UTC (Z).
EXPORT_INITIAL_UPDATED_SINCE=2026-10-01T00:00:00Z
EXPORT_DIR=/app/exports
# Uno o varios destinatarios separados por comas
EXPORT_RECIPIENT=integration@example.test

# --- SMTP -------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=export-service@example.test
# Vacíos en local: Mailpit no requiere autenticación
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_RETRIES=3

# --- Worker -----------------------------------------------------------------
# Cada cuánto busca ejecuciones pendientes
WORKER_POLL_INTERVAL_SECONDS=5
# Si el worker no renueva su reserva en este tiempo, se considera caído
WORKER_LEASE_SECONDS=300

# --- Scheduler (Ofelia) -----------------------------------------------------
SCHEDULE=@every 5m

# --- Base de datos (PostgreSQL) ---------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=export_service
POSTGRES_USER=export_service
# Solo para el contenedor local y desechable de Docker. En producción se inyecta
# como secret (Portainer secrets, Azure Key Vault) y nunca se escribe aquí.
POSTGRES_PASSWORD=solo_desarrollo_local
